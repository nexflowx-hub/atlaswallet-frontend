{
  "specVersion": "1.0.0",
  "project": {
    "name": "AtlasWallet",
    "productName": "Atlas Wallet",
    "legalEntityName": "Atlas Wallet Ltd",
    "tagline": "Money · Crypto · Investments · One Portfolio.",
    "positioning": "A unified digital portfolio for money, crypto, exchange and eligible private investment opportunities.",
    "domains": {
      "marketing": "https://atlaswallet.org",
      "www": "https://www.atlaswallet.org",
      "app": "https://app.atlaswallet.org",
      "api": "https://api.atlaswallet.org"
    },
    "frontendRepository": "nexflowx-hub/atlaswallet-frontend",
    "backendRepository": "nexflowx-hub/atlaswallet-backend",
    "deployment": "Vercel"
  },
  "productRules": [
    "Fast entry: email + password first; authenticated dashboard immediately after session + account bootstrap.",
    "Self-declared profile is progressive and skippable.",
    "KYC is not a universal frontend blocker; operation eligibility comes from backend policy/provider/route/risk rules.",
    "Frontend never writes authoritative financial balances directly to Supabase/PostgreSQL.",
    "All financial state, fees, quotes, capabilities, settlement and investment state come from AtlasWallet Backend API.",
    "Never expose provider secrets, service-role keys, DB credentials or private crypto keys.",
    "Never fabricate balances, successful transactions, user counts, testimonials, provider availability, licenses or guarantees.",
    "BLACK_30 is a commercial tier; SELF_DECLARED is an identity level; KYC is a separate state.",
    "Requested capabilities and effective capabilities are distinct.",
    "Investment claims are jurisdiction/eligibility/legal-review gated."
  ],
  "stack": {
    "framework": "Next.js App Router",
    "language": "TypeScript",
    "runtime": "Node.js 22+",
    "styling": "Tailwind CSS + CSS variables",
    "components": "shadcn/ui customized for AtlasWallet",
    "icons": "Lucide React",
    "forms": "React Hook Form + Zod",
    "serverState": "TanStack Query",
    "auth": "Supabase Auth for auth/session only",
    "i18n": "next-intl",
    "charts": "Recharts/lightweight SVG",
    "motion": "Framer Motion subtle only",
    "tests": "Vitest + React Testing Library + Playwright",
    "deployment": "Vercel"
  },
  "architecture": {
    "strategy": "Single Next.js repository with shared design system and hostname-aware marketing/app shells.",
    "hosts": {
      "atlaswallet.org": "marketing/legal",
      "app.atlaswallet.org": "authenticated operational app"
    },
    "routeGroups": {
      "(marketing)": "public pages",
      "(auth)": "authentication",
      "(app)": "authenticated app",
      "(legal)": "legal/institutional"
    },
    "securityBoundary": {
      "supabase": "authentication/session only; no financial DB operations from frontend",
      "backend": "all account/wallet/fee/quote/transaction/investment operations via api.atlaswallet.org",
      "authorization": "Bearer Supabase access token to AtlasWallet API over HTTPS",
      "secrets": "Only browser-safe NEXT_PUBLIC Supabase values are allowed in frontend environment."
    }
  },
  "environment": {
    "public": {
      "NEXT_PUBLIC_SITE_URL": "https://atlaswallet.org",
      "NEXT_PUBLIC_APP_URL": "https://app.atlaswallet.org",
      "NEXT_PUBLIC_API_URL": "https://api.atlaswallet.org",
      "NEXT_PUBLIC_SUPABASE_URL": "<deploy-value>",
      "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "<deploy-value>"
    },
    "featureFlags": {
      "NEXT_PUBLIC_FEATURE_EXCHANGE": "true",
      "NEXT_PUBLIC_FEATURE_INVEST": "true",
      "NEXT_PUBLIC_FEATURE_ACTIVITY": "true",
      "NEXT_PUBLIC_FEATURE_SUPPORT_WIDGET": "true",
      "NEXT_PUBLIC_FEATURE_PWA": "false"
    },
    "forbidden": [
      "DATABASE_URL",
      "DIRECT_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
      "provider API secrets",
      "crypto private keys"
    ]
  },
