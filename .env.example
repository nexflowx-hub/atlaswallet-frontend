# AtlasWallet frontend — non-secret environment contract
# Financial data must always come from the AtlasWallet API.
NEXT_PUBLIC_API_URL=https://api.atlaswallet.org

# Supabase is used for Auth/session only in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Production safety: keep false/unset. Enable only for an explicit demo deployment.
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
